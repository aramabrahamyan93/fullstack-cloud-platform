# Local addon configuration.
# Follows the same config/addons/<env>.env pattern as dev/staging.
# Keep this file minimal: only values that are real local choices belong here.
# Namespaces, release names, chart paths, value files, and service names are derived.

ENABLE_ARGOCD=true
ENABLE_ARGOCD_APPLICATION=true
ENABLE_MONITORING=true

# Pin local addon chart versions for reproducible zero-state installs.
MONITORING_CHART_VERSION=86.3.2
ARGOCD_CHART_VERSION=9.6.0

ARGOCD_TARGET_REVISION=develop

APP_ACCESS_LOCAL_PORT=18081
ARGOCD_LOCAL_PORT=18443
PROMETHEUS_LOCAL_PORT=19091
GRAFANA_LOCAL_PORT=13000
